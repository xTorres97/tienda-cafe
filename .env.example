# Base de datos: Neon en producción, o PGlite local (Postgres embebido, sin instalar nada)
DATABASE_URL=pglite:./.pglite
# DATABASE_URL=postgresql://usuario:clave@ep-xxx.neon.tech/neondb?sslmode=require

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Panel de administración
ADMIN_EMAIL=admin@sombradebucare.test
ADMIN_PASSWORD=cambia-esta-clave
# Mínimo 32 caracteres (openssl rand -hex 32)
AUTH_SECRET=
# 1 = mostrar el botón "Entrar con la cuenta de demostración" en el login
DEMO_MODE=1

# Firma de los webhooks de pago
PAYMENTS_WEBHOOK_SECRET=
# Protege /api/cron/reset (Vercel Cron lo envía solo)
CRON_SECRET=
